# Public (exposed to client) - must start with NEXT_PUBLIC_
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_TITLE=My Blog
NEXT_PUBLIC_SITE_DESCRIPTION=个人博客
NEXT_PUBLIC_AUTHOR_NAME=Your Name
NEXT_PUBLIC_AUTHOR_GITHUB=https://github.com/yourname
NEXT_PUBLIC_AUTHOR_EMAIL=you@example.com

# Server-side secrets (do NOT commit real values)
SMTP_URL=smtp://user:pass@smtp.example.com
DATABASE_URL=postgres://user:pass@localhost:5432/dbname
